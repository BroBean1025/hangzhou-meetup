  "description": "Hangzhou MeetUp · 杭城同行：多校区、地铁站出发的通勤与共同出行地图",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
