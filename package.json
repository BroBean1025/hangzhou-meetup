{
  "name": "hangzhou-meetup",
  "version": "0.2.0",
  "private": true,
  "description": "Hangzhou MeetUp · 杭城同行：多校区、地铁站出发的通勤与共同出行地图",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/build.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "pack:release": "node scripts/package.mjs",
    "desktop": "electron .",
    "dist:win": "node scripts/build.mjs && electron-builder --win nsis portable --x64 --publish never",
    "test:desktop": "node scripts/test-desktop.mjs",
    "check:desktop": "node scripts/check-desktop-package.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "main": "desktop/main.mjs",
  "author": "Hangzhou MeetUp",
  "build": {
    "appId": "com.hangzhou.meetup",
    "productName": "杭城同行",
    "directories": {
      "output": "desktop-output",
      "buildResources": "desktop"
    },
    "files": [
      "public/**/*",
      "config/**/*",
      "lib/**/*",
      "server.mjs",
      "desktop/icon.ico",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "desktop/*.mjs",
      "desktop/*.cjs"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.ico",
      "executableName": "HangzhouMeetUp",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "杭城同行",
      "artifactName": "HangzhouMeetUp-Setup-${version}.exe",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "HangzhouMeetUp-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "BroBean1025",
      "repo": "hangzhou-meetup",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "semver": "7.8.6"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BroBean1025/hangzhou-meetup.git"
  }
}
